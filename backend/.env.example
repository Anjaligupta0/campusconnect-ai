# ---- Required ----
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
JWT_SECRET=replace-with-a-long-random-string
PORT=5000

# Allowed frontend URL(s), comma separated
CORS_ORIGIN=http://localhost:5173

# ---- AI ----
# ollama = local development, groq = deployed demo, none = rules only
AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Groq (deployment) - free key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Photo storage (deployment) ----
# Leave empty locally: photos are saved in the uploads folder.
# On Render, set all three (free account at cloudinary.com).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET= 